# Passo 1: Build (compilar código)
FROM node:18-alpine AS builder

WORKDIR /app

COPY backend/package*.json ./
RUN npm ci

COPY backend .
RUN npm run build

# Passo 2: Production (apenas o necessário)
FROM node:18-alpine

WORKDIR /app

# Instalar PostgreSQL client (para backup)
RUN apk add --no-cache postgresql-client

# Copiar dependências
COPY backend/package*.json ./
RUN npm ci --only=production

# Copiar código compilado
COPY --from=builder /app/dist ./dist
COPY backend/prisma ./prisma

EXPOSE 3001

CMD ["npm", "start"]