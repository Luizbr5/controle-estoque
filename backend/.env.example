# Ambiente
NODE_ENV=development

# Servidor
PORT=3001
API_PREFIX=/api/v1

# Banco de dados
DATABASE_URL=postgresql://user:password@localhost:5432/controle_estoque

# JWT (chave para gerar tokens)
JWT_SECRET=sua-chave-secreta-super-segura-aqui
JWT_EXPIRES_IN=7d

# Sentry (monitora erros em produção)
SENTRY_DSN=https://seu-sentry-dsn@sentry.io/seu-project-id

# CORS (quem pode acessar)
FRONTEND_URL=http://localhost:5173

# Rate Limiting (proteção contra ataque)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5
