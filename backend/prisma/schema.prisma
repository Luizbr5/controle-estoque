// ============================================================================
// Prisma Schema — Controle de Estoque API Multi-tenant (contrato v3.0.0)
// Toda alteração de banco ocorre EXCLUSIVAMENTE via migrations geradas a partir
// deste arquivo. Nenhum SQL manual é utilizado em nenhuma camada da aplicação.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====== ENUMS ======

enum UserRole {
  OWNER
  ADMIN
  EMPLOYEE
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

// ====== COMPANY (NOVO) ======

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  products       Product[]
  categories     Category[]
  stockMovements StockMovement[]

  @@index([slug])
  @@map("companies")
}

// ====== USER (MODIFICADO) ======

model User {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  email     String
  password  String
  role      UserRole @default(EMPLOYEE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

// ====== CATEGORY (MODIFICADO) ======

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  description String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("categories")
}

// ====== PRODUCT (MODIFICADO) ======

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  name        String
  description String?
  sku         String?
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(0)
  minQuantity Int      @default(5) @map("min_quantity")
  unit        String   @default("un")
  isActive    Boolean  @default(true) @map("is_active")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

// ====== STOCK MOVEMENT (MODIFICADO) ======

model StockMovement {
  id                   String        @id @default(uuid()) @db.Uuid
  companyId            String        @map("company_id") @db.Uuid
  productId            String        @map("product_id") @db.Uuid
  userId               String?       @map("user_id") @db.Uuid
  type                 MovementType
  quantity             Int
  reason               String?
  productQuantityAfter Int           @map("product_quantity_after")
  createdAt            DateTime      @default(now()) @map("created_at")

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}